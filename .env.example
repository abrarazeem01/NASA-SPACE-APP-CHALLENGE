# TeleConnection: NASA Earth Trend Detective
# Supabase Configuration
# Optional: The application runs with 100% functionality out of the box using LocalStorage fallback.
# If you want multi-user real-time cloud persistence, add your Supabase project credentials:
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Supabase Table Schema:
# create table discoveries (
#   id text primary key,
#   created_at timestamp with time zone default timezone('utc'::text, now()),
#   title text not null,
#   variable text not null,
#   variable_name text not null,
#   loc_a_name text not null,
#   loc_a_lat numeric not null,
#   loc_a_lon numeric not null,
#   loc_b_name text not null,
#   loc_b_lat numeric not null,
#   loc_b_lon numeric not null,
#   slope_a_decade numeric not null,
#   slope_b_decade numeric not null,
#   p_value_a numeric not null,
#   p_value_b numeric not null,
#   r numeric not null,
#   verdict text not null,
#   confidence_score numeric not null,
#   notes text,
#   upvotes integer default 1,
#   author text not null
# );
